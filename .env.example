# Client-safe (can be exposed in browser)
# Next.js mode: these NEXT_PUBLIC_* variables are exposed client-side.
NEXT_PUBLIC_CONTACT_ENDPOINT=/api/contact
NEXT_PUBLIC_BREVO_API_KEY=your_client_side_brevo_key
NEXT_PUBLIC_CONTACT_TO_EMAIL=n.a.karthiksurya@gmail.com
NEXT_PUBLIC_CONTACT_FROM_EMAIL=hello@nakarthiksurya.com

# Analytics / tracking
NEXT_PUBLIC_GA_MEASUREMENT_ID=G-XXXXXXXXXX
NEXT_PUBLIC_GTM_ID=GTM-XXXXXXX

# Server-only (never prefix with NEXT_PUBLIC_)
BREVO_API_KEY=your_brevo_api_key
CONTACT_TO_EMAIL=n.a.karthiksurya@gmail.com
CONTACT_FROM_EMAIL=hello@nakarthiksurya.com
